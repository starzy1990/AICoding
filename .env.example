# 如果本项目 .env 中也配置了同名变量，本项目 .env 优先。
DEEPSEEK_API_KEY="sk-xxxxxxxx"
DEEPSEEK_BASE_URL="https://api.deepseek.com"
MAIN_MODEL=deepseek-v4-pro
GITEE_TOKEN="xxxxxx"
GITEE_API_BASE_URL="https://gitee.com/api/v5"
GITEE_WEB_BASE_URL="https://gitee.com"

# Agent 只允许操作这个工作区下的仓库文件。
AI_WORKSPACE_ROOT=E:\ai_workspace

# MySQL 数据库配置
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=Root#*123
MYSQL_DATABASE=aicareeros

# 日志文件固定放在课程项目 logs 目录。
LX_AICODING_LOG_DIR=E:\my_project\LX_AICoding\logs

ZHIPU_API_KEY="xxxxx.xxxxx"
ZHIPU_BASE_URL="https://open.bigmodel.cn/api/paas/v4/"

DEFAULT_REPO_PROVIDER="gitee"
LANGCHAIN_TRACING_V2=
LANGSMITH_TRACING=false
DASHBOARD_BASE_URL=http://127.0.0.1:3000
DASHBOARD_API_BASE_URL=http://127.0.0.1:2024
DASHBOARD_ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
DASHBOARD_DEV_LOGIN=admin
DASHBOARD_DEV_EMAIL=admin@example.com
CONFIGURED_ADMINS=admin@example.com
DASHBOARD_JWT_SECRET=1b3f0add152896994274f429cd18fe8a57a4f149712ed24f185895fe26a6d63e
SANDBOX_TYPE=local_shell
LOCAL_SHELL_WORKSPACE=E:\ai_workspace
LOCAL_SHELL_PROJECTS_DIR=projects
LOCAL_SHELL_SHARED_PYTHON_VENV=runtimes\python\default\.venv
LOCAL_SHELL_ENABLE_COMMAND_GUARD=true
LOCAL_SHELL_ALLOW_NETWORK=true
# Logging rotation. Current logs are backend.log / agent-runs.log; rotated logs use .YYYY-MM-DD suffix.
LX_AICODING_LOG_LEVEL=INFO
LX_AICODING_LOG_RETENTION_DAYS=14
LX_AICODING_LOG_WHEN=midnight
LX_AICODING_LOG_INTERVAL=1

# Agent 运行保护阈值。复杂 coding 任务需要给代码修改、测试和 Git/PR 收尾预留足够工具调用额度。
AGENT_MAX_TOOL_CALLS=240
AGENT_MAX_SECONDS=1800
AGENT_CODING_MAX_TOOL_CALLS=300
AGENT_CODING_MAX_SECONDS=1800

# OpenSandbox Configuration
OPENSANDBOX_DOMAIN=api.opensandbox.io
OPENSANDBOX_API_KEY=your-api-key
OPENSANDBOX_IMAGE=sandbox-registry.cn-zhangjiakou.cr.aliyuncs.com/opensandbox/code-interpreter:v1.0.2
OPENSANDBOX_TIMEOUT=600